DOLIBARR_API_URL=https://localhost/sports-way/htdocs/api/index.php
DOLIBARR_API_KEY=replace-with-generated-dolapikey
DOLIBARR_VERIFY_SSL=false
DOLIBARR_DOCUMENTS_ROOT=C:/xampp/htdocs/sports-way/documents

CORS_ORIGINS=http://localhost:5173,https://localhost

# Order notifications (moved server-side — never put these in frontend code)
FORMSUBMIT_EMAIL=sales@sports-way.com
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WHATSAPP_RECIPIENT=

# Used only by the /orders router (Dolibarr website-orders module).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DOLIBARR_SYNC_SECRET=replace-with-a-random-secret-shared-with-the-dolibarr-module

# Used only by /admin/users delete. Safe to be the public anon key.
SUPABASE_ANON_KEY=
